{
  "_id": "6a69b158e64efd000136fbce",
  "id": "0972b7f2e6d241c4b1ff87a15def7027",
  "name": "Edenred — JWT Auth (Keycloak) Baseline",
  "org_id": "68f8efa116098c000109f416",
  "description": "Blueprint for new Tyk OAS APIs secured with JWT against the Edenred Keycloak realm. Subject-identity claim is preconfigured; set the upstream URL and listen path when creating an API from this template. JWKS and scope-to-policy mapping are intentionally left out — populate them via the Identity Provider Registry (either through a DCR approval in the Portal, or directly via the Dashboard API's /api/clientidps) rather than hardcoding them here.",
  "kind": "oas-template",
  "data": {
    "openapi": "3.0.3",
    "info": {
      "title": "New API from Edenred JWT Template",
      "version": "1.0.0"
    },
    "paths": {},
    "components": {
      "securitySchemes": {
        "jwtAuth": {
          "type": "http",
          "scheme": "bearer",
          "bearerFormat": "JWT"
        }
      }
    },
    "security": [
      {
        "jwtAuth": []
      }
    ],
    "x-tyk-api-gateway": {
      "info": {
        "name": "New API from Edenred JWT Template",
        "state": {
          "active": false
        }
      },
      "upstream": {
        "url": "https://REPLACE-ME.example.com"
      },
      "server": {
        "listenPath": {
          "value": "/replace-me/",
          "strip": true
        },
        "detailedTracing": {
          "enabled": true
        },
        "authentication": {
          "enabled": true,
          "securityScheme": {
            "jwtAuth": {
              "enabled": true
            }
          },
          "securitySchemes": {
            "jwtAuth": {
              "enabled": true,
              "header": {
                "enabled": true,
                "name": "Authorization"
              },
              "signingMethod": "rsa",
              "skipKid": true,
              "subjectClaims": [
                "client_id"
              ],
              "identityBaseField": "client_id"
            }
          }
        }
      },
      "middleware": {
        "global": {
          "contextVariables": {
            "enabled": true
          },
          "trafficLogs": {
            "enabled": true
          }
        }
      }
    }
  },
  "last_updated": "2026-07-29T07:52:56.741Z"
}